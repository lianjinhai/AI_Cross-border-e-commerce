ERP_ENV=development
ERP_DB_URL=sqlite:///./backend/erp.db
ERP_JWT_SECRET=replace-with-at-least-32-random-bytes
ERP_JWT_EXPIRE_MINUTES=720
ERP_ADMIN_PASSWORD=replace-with-a-strong-password
# 可用 `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"` 生成
ERP_CREDENTIAL_KEY=replace-with-fernet-key
ERP_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ERP_PUBLIC_BASE_URL=http://127.0.0.1:8000
ERP_RULES_URL=
ERP_RULES_SIGNING_KEY=
# 平台服务商（superadmin）账号：不配置则不创建，业务租户管理员用 ERP_ADMIN_PASSWORD
ERP_SUPERADMIN_USERNAME=root
ERP_SUPERADMIN_PASSWORD=

# ---- LLM（可选）：留空则全部 Agent 走确定性规则引擎，功能仍完整可用 ----
ERP_LLM_API_KEY=
ERP_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ERP_LLM_MODEL=glm-4-flash
ERP_LLM_MODEL_SMALL=glm-4-flash
ERP_LLM_EMBEDDING_MODEL=embedding-3
ERP_LLM_TIMEOUT=45

# ---- 服务监听 ----
ERP_HOST=127.0.0.1
ERP_PORT=8000

# 每个平台默认 sandbox；获得正式批准并完成验收后才改 production。
ERP_TIKTOK_ENV=sandbox
ERP_EBAY_ENV=sandbox
ERP_WALMART_ENV=sandbox
ERP_LAZADA_ENV=sandbox
