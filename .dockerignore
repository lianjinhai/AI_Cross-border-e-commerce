# ---- Python ----
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/

# ---- 本地数据库 ----
backend/*.db
!backend/*.db.example
# SQLite 旁文件与备份（backend/*.db 不匹配这些名字）
backend/*.db-wal
backend/*.db-shm
backend/*.db-journal
backend/*.db.bak-*
# 冷备目录：backend/*.db 不匹配子目录，必须单独列
backend/backups/
_erp_backups/
_wip_backup/
/_*.py

# ---- 前端 ----
frontend/node_modules/
frontend/.zcode/
frontend/dist/

# ---- 其它 ----
*.log
.git/
nul
# 密钥与本地配置：绝不进入构建上下文
.env
.env.*
!.env.example
# 文档、测试与协作规范不进生产镜像
docs/
backend/tests/
.github/
AGENTS.md
README.md
# Vite 构建临时文件不进镜像
frontend/vite.config.js.timestamp-*.mjs
